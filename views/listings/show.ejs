<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3>Listing Details</h3>
  </div>

  <div class="card col-6 offset-3 show-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="Listing_img"
    />

    <div class="card-body">
      <p class="card-text">
        <b><%= listing.title %></b><br />
        <%= listing.description %><br />
        &#8377;<%= listing.price %><br />
        <%= listing.location %><br />
        <%= listing.country %>
      </p>
    </div>
  </div>

  <!-- Show Edit & Delete only to Owner -->
  <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>

    <div class="btns mt-1">

      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark offset-3 edit-btn"
      >
        Edit
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button class="btn btn-dark offset-5">
          Delete
        </button>
      </form>

    </div>

  <% } %>

</div>
<hr>

<% if(currUser){ %>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h4>Leave a Review</h4>

        <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation"
        >

            <div class="mb-3">

                <label class="form-label">Rating</label>

                <input
                    type="range"
                    min="1"
                    max="5"
                    name="review[rating]"
                    class="form-range"
                >

            </div>

            <div class="mb-3">

                <label class="form-label">Comment</label>

                <textarea
                    name="review[comment]"
                    class="form-control"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please write a review.
                </div>

            </div>

            <button class="btn btn-dark">
                Submit Review
            </button>

        </form>

    </div>
</div>

<% } %>
<hr>

<div class="row mt-3">
    <div class="col-8 offset-2">

        <h4>All Reviews</h4>

        <% for(let review of listing.reviews){ %>

            <div class="card mb-3">

                <div class="card-body">

                    <h5>
                        Rating: <%= review.rating %> ⭐
                    </h5>

                    <p>
                        <%= review.comment %>
                    </p>

                </div>

            </div>

        <% } %>

    </div>
</div>