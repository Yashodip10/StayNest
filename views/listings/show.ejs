<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <h2 class="fw-bold mb-3">
        <%= listing.title %>
    </h2>

    <p class="text-muted fs-5">
        📍 <%= listing.location %>, <%= listing.country %>
    </p>

    <div class="row g-5 mt-4 align-items-start">

        <div class="col-lg-8 col-md-12">

            <img
                src="<%= listing.image.url %>"
                class="img-fluid rounded-4 shadow listing-show-img"
                alt="<%= listing.title %>"
            >

            <div class="mt-4">

                <h4 class="fw-bold mt-4">
                 Description
               </h4>

                <p class="text-muted fs-5">
                    <%= listing.description %>
                </p>

            </div>

        </div>

        <div class="col-lg-4 col-md-12">

           <div class="card shadow-lg border-0 rounded-4 p-4 booking-card">

                <h3 class="text-danger fw-bold">

                    ₹<%= listing.price.toLocaleString("en-IN") %>

                    <span class="fs-5 text-dark">
                        / night
                    </span>

                </h3>

                <hr>
<form
    action="/bookings/<%= listing._id %>"
    method="POST"
>

    <button
        class="btn btn-danger w-100 rounded-pill mb-3"
    >
        Book Now
    </button>

</form>

              <form action="/wishlist/<%= listing._id %>" method="POST">

<button
class="btn btn-outline-dark w-100 rounded-pill"
>

❤️ Save

</button>

</form>

                <hr>

                <h6>

                    Hosted By

                </h6>

                <p>

                    <%= listing.owner.username %>

                </p>

            </div>

        </div>

    </div>

    <hr class="my-5">
<h3 class="fw-bold mt-5 mb-4">

⭐ Guest Reviews

</h3>

<% if(currUser){ %>

<form action="/listings/<%= listing._id %>/reviews" method="POST">

    <div class="mb-3">

        <label class="form-label">Rating</label>

        <input
            type="range"
            min="1"
            max="5"
            name="review[rating]"
            class="form-range"
        >

    </div>

    <div class="mb-3">

        <label class="form-label">Comment</label>

        <textarea
            name="review[comment]"
            class="form-control"
            rows="4"
            required
        ></textarea>

    </div>

    <button class="btn btn-danger rounded-pill">

        Submit Review

    </button>

</form>

<% } %>

<hr class="my-5">

<div class="row">

<% if(listing.reviews.length === 0){ %>

    <p class="text-muted">No reviews yet. Be the first to review this place!</p>

<% } %>
<% for(let review of listing.reviews){ %>

<div class="col-lg-6 col-md-12 mb-4">

<div class="card review-card border-0">

<div class="card shadow-sm rounded-4 border-0 h-100">

<h5 class="fw-bold">

<%= review.author.username %>

</h5>

<div class="mb-2">

    <% for(let i = 1; i <= 5; i++){ %>

        <% if(i <= review.rating){ %>

            <i class="fa-solid fa-star text-warning"></i>

        <% } else { %>

            <i class="fa-regular fa-star text-warning"></i>

        <% } %>

    <% } %>

</div>

<p>

<%= review.comment %>

</p>
<% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>

<form
    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
    method="POST"
>

    <button class="btn btn-sm btn-outline-danger">
        Delete Review
    </button>

</form>

<% } %>

</div>

</div>

</div>

<% } %>


</div>
    <% if(currUser && listing.owner._id.equals(currUser._id)){ %>

    <div class="mt-5 d-flex gap-3">

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-warning rounded-pill px-4"
        >

            Edit

        </a>

        <form
            action="/listings/<%= listing._id %>?_method=DELETE"
            method="POST"
        >

            <button class="btn btn-danger rounded-pill px-4">

                Delete

            </button>

        </form>

    </div>

    <% } %>

</div>