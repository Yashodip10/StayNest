<% layout("/layouts/boilerplate") %>

<%- include("../includes/filters") %>

<div class="container mt-5">

    <h1 class="fw-bold mb-5">Explore Amazing Places</h1>

    <div class="row g-4">

<% if(allListings.length === 0){ %>

    <div class="col-12 text-center mt-5">

        <i class="fa-solid fa-magnifying-glass fa-3x text-secondary mb-3"></i>

        <h3>No Listings Found</h3>

        <p class="text-muted">
            Try searching with another location or title.
        </p>

    </div>

<% } %>

<% for(let listing of allListings){ %>

        <div class="col-lg-4 col-md-6 col-sm-12">

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <div class="card listing-card h-100">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top listing-img"
                        alt="<%= listing.title %>"
                    >

                    <div class="card-body">

                        <h5 class="card-title mb-2">
                            <%= listing.title %>
                        </h5>

                        <p class="text-muted mb-2">
                            📍 <%= listing.location %>, <%= listing.country %>
                        </p>

                        <h5 class="text-danger fw-bold">
                            ₹<%= listing.price.toLocaleString("en-IN") %>
                            <small class="text-muted fs-6"> / night</small>
                        </h5>

                    </div>

                </div>

            </a>

        </div>

        <% } %>

    </div>

</div>